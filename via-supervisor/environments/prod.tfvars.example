# via-supervisor / prod — Cloud Storage + Secret Manager only (no Cloud Run).
#   terraform plan -var-file=environments/prod.tfvars.example
#
# This agent: one bucket (via-supervisor-prod-bucket).
# Two-bucket agent (same module, different folder/tfvars):
#   buckets = {
#     bucket = {}
#     data   = {}
#   }

project_id  = "freyr-ai"
region      = "us-east1"
environment = "prod"

buckets = {
  bucket = {
    force_destroy = false
  }
}

secret_keys = [
  "app-config",
]
