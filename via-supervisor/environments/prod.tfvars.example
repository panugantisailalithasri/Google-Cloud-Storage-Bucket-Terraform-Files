# via-supervisor / Production
# Same stack as DevSecOps. Only this file (and pipeline environment=prod) changes.
#
# GCP names are composed as productname-ENVname-Resourcename:
#   via-supervisor-prod-bucket
#   via-supervisor-prod-run
#   via-supervisor-prod-sql
#   via-superagent-prod-bucket   (product_name override)
#
# No service accounts are created. Cloud Run runtime identity =
#   runtime_service_account_email (the existing ADO deployer SA).

product_name = "via-supervisor"
environment  = "prod"
project_id   = "freyr-ai"
region       = "us-east4"
location     = "us-east4"

runtime_service_account_email = "ado-deployer-v3@freyr-ai.iam.gserviceaccount.com"

labels = {
  team    = "ai-agents"
  program = "dso"
}

enable_apis = true

vpc_network = "freya-ai-dev-vpc"
vpc_subnet  = "freya-ai-dev-subnet-us-east4"
vpc_egress  = "PRIVATE_RANGES_ONLY"

buckets = {
  supervisor = {
    resource_name      = "bucket"
    storage_class      = "STANDARD"
    versioning_enabled = true
    force_destroy      = false
    lifecycle_age_days = 90
    kms_key_name       = null
    runtime_role       = "roles/storage.objectViewer"
    extra_iam_members  = []
  }
  superagent = {
    product_name       = "via-superagent"
    resource_name      = "bucket"
    storage_class      = "STANDARD"
    versioning_enabled = true
    force_destroy      = false
    lifecycle_age_days = 90
    kms_key_name       = null
    runtime_role       = "roles/storage.objectViewer"
    extra_iam_members  = []
  }
}

secrets = {
  supervisor = {
    resource_name = "secret"
  }
  supervisor_session = {
    resource_name = "session"
  }
  supervisor_memory = {
    resource_name = "memory"
  }
  superagent = {
    product_name  = "via-superagent"
    resource_name = "secret"
  }
  superagent_session = {
    product_name  = "via-superagent"
    resource_name = "session"
  }
  cognito = {
    resource_name = "cognito"
  }
}

sql_instances = {
  sql = {
    resource_name       = "sql"
    database_version    = "POSTGRES_18"
    tier                = "db-custom-2-4096"
    disk_size_gb        = 10
    databases           = ["ff-freya-supervisor-pac-adk", "ff-freya-supervisor-pac-langgraph"]
    iam_authentication  = true
    pitr_enabled        = true
    query_insights      = true
    deletion_protection = true
    ssl_mode            = "ALLOW_UNENCRYPTED_AND_ENCRYPTED"
    kms_key_name        = null
  }
  superagent_sql = {
    product_name        = "via-superagent"
    resource_name       = "sql"
    database_version    = "POSTGRES_18"
    tier                = "db-custom-2-4096"
    disk_size_gb        = 10
    databases           = ["ff-freya-sa-pac-langgraph"]
    iam_authentication  = true
    pitr_enabled        = true
    query_insights      = true
    deletion_protection = true
    ssl_mode            = "ALLOW_UNENCRYPTED_AND_ENCRYPTED"
    kms_key_name        = null
  }
  memory_sql = {
    resource_name       = "memory-sql"
    database_version    = "POSTGRES_18"
    tier                = "db-custom-2-8192"
    disk_size_gb        = 100
    databases           = ["mem0_db"]
    iam_authentication  = true
    pitr_enabled        = true
    query_insights      = true
    deletion_protection = true
    ssl_mode            = "ALLOW_UNENCRYPTED_AND_ENCRYPTED"
    kms_key_name        = "projects/freyr-ai/locations/us-east4/keyRings/via-dso/cryptoKeys/cloud-sql"
  }
}

cloud_run_services = {
  supervisor = {
    resource_name      = "run"
    image              = "us-east4-docker.pkg.dev/freyr-ai/via-supervisor/via-supervisor:dso"
    config_bucket_key  = "supervisor"
    session_secret_key = "supervisor_session"
    memory_secret_key  = "supervisor_memory"
    port               = 8080
    cpu                = "2"
    memory             = "4Gi"
    min_instances         = 1
    max_instances         = 3
    concurrency           = 320
    timeout_seconds       = 300
    env_vars = {
      GCS_CONFIG_OBJECT = "ff-freya-supervisor/dev/ff-freya-supervisor-common.json"
    }
    secret_env_keys = {
      VIA_SUPERVISOR_SECRET = "supervisor"
      VIA_SESSION_SECRET    = "supervisor_session"
      VIA_MEMORY_SECRET     = "supervisor_memory"
      VIA_COGNITO_M2M       = "cognito"
    }
    ingress               = "INGRESS_TRAFFIC_ALL"
    allow_unauthenticated = true
    extra_invoker_members = []
    deletion_protection   = true
  }
  superagent = {
    product_name       = "via-superagent"
    resource_name      = "run"
    image              = "us-east4-docker.pkg.dev/freyr-ai/via-superagent/via-superagent:dso"
    config_bucket_key  = "superagent"
    session_secret_key = "superagent_session"
    port               = 8080
    cpu                = "2"
    memory             = "4Gi"
    min_instances         = 1
    max_instances         = 3
    concurrency           = 320
    timeout_seconds       = 300
    env_vars = {
      GCS_CONFIG_OBJECT = "ff-freya-superagents-pac/dev/ff-freya-superagents-pac-common.json"
    }
    secret_env_keys = {
      VIA_SUPERAGENT_SECRET = "superagent"
      VIA_SESSION_SECRET    = "superagent_session"
      VIA_COGNITO_M2M       = "cognito"
    }
    ingress               = "INGRESS_TRAFFIC_ALL"
    allow_unauthenticated = false
    extra_invoker_members = []
    deletion_protection   = true
  }
}

gemini_enterprise = {
  application_id     = "freyr-gemini-enterprise_1776958711324"
  via_agent_id       = "14759281635611028992"
  agent_display_name = "VIA"
}

observability = {
  via_tracing_enabled = true
  traces_endpoint     = "https://telemetry.googleapis.com:443/v1/traces"
  pac_tracing_enabled = false
}

pac_external = {
  regulatory_mcp = "https://api.devsecops.freyafusion.com/grr/requirement-mcp"
  concept_graph  = "https://api.devsecops.freyafusion.com/grr/graph-service"
}
