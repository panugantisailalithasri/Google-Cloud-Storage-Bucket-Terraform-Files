# via-supervisor / dev
# Source of truth for every variable in ../variables.tf
# Naming: <product_name>-<environment>-<resource>
# Cloud SQL uses the instance already created in GCP (do not create -dso copies).

product_name = "via-supervisor"
environment  = "dev"
project_id   = "freyr-ai"
region       = "us-east4"
location     = "us-east4"

labels = {
  team    = "ai-agents"
  program = "dso"
}

enable_apis = true

vpc_network = "freya-ai-dev-vpc"
vpc_subnet  = "freya-ai-dev-subnet-us-east4"
vpc_egress  = "PRIVATE_RANGES_ONLY"

service_accounts = {
  supervisor = {
    account_id   = "via-supervisor-dev-sa"
    display_name = "VIA supervisor dev"
    description  = "Runtime identity for via-supervisor-dev-run"
    project_roles = [
      "roles/logging.logWriter",
      "roles/monitoring.metricWriter",
      "roles/aiplatform.user",
      "roles/cloudsql.client",
      "roles/telemetry.tracesWriter",
    ]
  }
  superagent = {
    account_id   = "via-superagent-dev-sa"
    display_name = "VIA superagent dev"
    description  = "Runtime identity for via-superagent-dev-run"
    project_roles = [
      "roles/logging.logWriter",
      "roles/monitoring.metricWriter",
      "roles/aiplatform.user",
      "roles/cloudsql.client",
      "roles/secretmanager.secretAccessor",
    ]
  }
}

buckets = {
  supervisor_config = {
    name               = "via-supervisor-dev-bucket"
    storage_class      = "STANDARD"
    versioning_enabled = true
    force_destroy      = false
    lifecycle_age_days = 90
    kms_key_name       = null
    runtime_role       = "roles/storage.objectViewer"
    accessor_sa_keys   = ["supervisor"]
    extra_iam_members  = []
  }
  superagent_config = {
    name               = "via-superagent-dev-bucket"
    storage_class      = "STANDARD"
    versioning_enabled = true
    force_destroy      = false
    lifecycle_age_days = 90
    kms_key_name       = null
    runtime_role       = "roles/storage.objectViewer"
    accessor_sa_keys   = ["superagent"]
    extra_iam_members  = []
  }
}

secrets = {
  supervisor = {
    secret_id        = "via-supervisor-dev-secret"
    accessor_sa_keys = ["supervisor"]
  }
  supervisor_session = {
    secret_id        = "via-supervisor-dev-session"
    accessor_sa_keys = ["supervisor"]
  }
  supervisor_memory = {
    secret_id        = "via-supervisor-dev-memory"
    accessor_sa_keys = ["supervisor"]
  }
  superagent = {
    secret_id        = "via-superagent-dev-secret"
    accessor_sa_keys = ["superagent"]
  }
  superagent_session = {
    secret_id        = "via-superagent-dev-session"
    accessor_sa_keys = ["superagent"]
  }
  cognito_m2m = {
    secret_id        = "via-supervisor-dev-cognito"
    accessor_sa_keys = ["supervisor", "superagent"]
  }
}

# Only the Cloud SQL instance that already exists in GCP.
# Creating additional -dso instances made terraform plan hang.
sql_instances = {
  supervisor_sessions = {
    name                = "via-supervisor-devsecops-east4"
    database_version    = "POSTGRES_18"
    tier                = "db-custom-1-3840"
    disk_size_gb        = 10
    databases           = ["ff-freya-supervisor-pac-adk", "ff-freya-supervisor-pac-langgraph"]
    iam_authentication  = true
    pitr_enabled        = true
    query_insights      = true
    deletion_protection = false
    ssl_mode            = "TRUSTED_CLIENT_CERTIFICATE_REQUIRED"
    kms_key_name        = null
  }
}

cloud_run_services = {
  supervisor = {
    name    = "via-supervisor-dev-run"
    image   = "us-east4-docker.pkg.dev/freyr-ai/via-supervisor/via-supervisor:dso"
    sa_key  = "supervisor"
    port    = 8080
    cpu     = "2"
    memory  = "4Gi"
    min_instances         = 1
    max_instances         = 3
    concurrency           = 320
    timeout_seconds       = 300
    env_vars = {
      SESSION_SERVICE_SECRET_NAME = "via-supervisor-dev-session"
      MEMORY_SERVICE_SECRET_NAME  = "via-supervisor-dev-memory"
      GCS_CONFIG_BUCKET           = "via-supervisor-dev-bucket"
      GCS_CONFIG_OBJECT           = "ff-freya-supervisor/dev/ff-freya-supervisor-common.json"
    }
    secret_env_keys = {
      VIA_SUPERVISOR_SECRET = "supervisor"
      VIA_SESSION_SECRET    = "supervisor_session"
      VIA_MEMORY_SECRET     = "supervisor_memory"
      VIA_COGNITO_M2M       = "cognito_m2m"
    }
    ingress               = "INGRESS_TRAFFIC_ALL"
    allow_unauthenticated = true
    invoker_sa_keys       = []
    extra_invoker_members = []
    deletion_protection   = true
  }
  superagent = {
    name    = "via-superagent-dev-run"
    image   = "us-east4-docker.pkg.dev/freyr-ai/via-superagent/via-superagent:dso"
    sa_key  = "superagent"
    port    = 8080
    cpu     = "2"
    memory  = "4Gi"
    min_instances         = 1
    max_instances         = 3
    concurrency           = 320
    timeout_seconds       = 300
    env_vars = {
      SESSION_SERVICE_SECRET_NAME = "via-superagent-dev-session"
      GCS_CONFIG_BUCKET           = "via-superagent-dev-bucket"
      GCS_CONFIG_OBJECT           = "ff-freya-superagents-pac/dev/ff-freya-superagents-pac-common.json"
    }
    secret_env_keys = {
      VIA_SUPERAGENT_SECRET = "superagent"
      VIA_SESSION_SECRET    = "superagent_session"
      VIA_COGNITO_M2M       = "cognito_m2m"
    }
    ingress               = "INGRESS_TRAFFIC_ALL"
    allow_unauthenticated = false
    invoker_sa_keys       = ["supervisor"]
    extra_invoker_members = []
    deletion_protection   = true
  }
}

gemini_enterprise = {
  application_id     = "freyr-gemini-enterprise_1776958711324"
  via_agent_id       = "14759281635611028992"
  agent_display_name = "VIA"
}

observability = {
  via_tracing_enabled = true
  traces_endpoint     = "https://telemetry.googleapis.com:443/v1/traces"
  pac_tracing_enabled = false
}

pac_external = {
  regulatory_mcp = "https://api.devsecops.freyafusion.com/grr/requirement-mcp"
  concept_graph  = "https://api.devsecops.freyafusion.com/grr/graph-service"
}
