# via-supervisor / DevSecOps
# Source of truth for every variable in ../variables.tf
#
# GCP names are NOT listed here. Terraform composes them as:
#   productname-ENVname-Resourcename
# from product_name (or per-resource product_name), environment, and resource_name.
#
# Examples with this file:
#   via-supervisor-devsecops-sa
#   via-supervisor-devsecops-bucket
#   via-supervisor-devsecops-run
#   via-supervisor-devsecops-east4   (existing Cloud SQL)
#   via-superagent-devsecops-sa      (product_name override)

product_name = "via-supervisor"
environment  = "devsecops"
project_id   = "freyr-ai"
region       = "us-east4"
location     = "us-east4"

labels = {
  team    = "ai-agents"
  program = "dso"
}

enable_apis = true

vpc_network = "freya-ai-dev-vpc"
vpc_subnet  = "freya-ai-dev-subnet-us-east4"
vpc_egress  = "PRIVATE_RANGES_ONLY"

service_accounts = {
  supervisor = {
    resource_name = "sa"
    display_name  = "VIA supervisor"
    description   = "Runtime identity for the supervisor Cloud Run service"
    project_roles = [
      "roles/logging.logWriter",
      "roles/monitoring.metricWriter",
      "roles/aiplatform.user",
      "roles/cloudsql.client",
      "roles/telemetry.tracesWriter",
    ]
  }
  superagent = {
    product_name  = "via-superagent"
    resource_name = "sa"
    display_name  = "VIA superagent"
    description   = "Runtime identity for the superagent Cloud Run service"
    project_roles = [
      "roles/logging.logWriter",
      "roles/monitoring.metricWriter",
      "roles/aiplatform.user",
      "roles/cloudsql.client",
      "roles/secretmanager.secretAccessor",
    ]
  }
}

buckets = {
  supervisor = {
    resource_name      = "bucket"
    storage_class      = "STANDARD"
    versioning_enabled = true
    force_destroy      = false
    lifecycle_age_days = 90
    kms_key_name       = null
    runtime_role       = "roles/storage.objectViewer"
    accessor_sa_keys   = ["supervisor"]
    extra_iam_members  = []
  }
  superagent = {
    product_name       = "via-superagent"
    resource_name      = "bucket"
    storage_class      = "STANDARD"
    versioning_enabled = true
    force_destroy      = false
    lifecycle_age_days = 90
    kms_key_name       = null
    runtime_role       = "roles/storage.objectViewer"
    accessor_sa_keys   = ["superagent"]
    extra_iam_members  = []
  }
}

secrets = {
  supervisor = {
    resource_name    = "secret"
    accessor_sa_keys = ["supervisor"]
  }
  supervisor_session = {
    resource_name    = "session"
    accessor_sa_keys = ["supervisor"]
  }
  supervisor_memory = {
    resource_name    = "memory"
    accessor_sa_keys = ["supervisor"]
  }
  superagent = {
    product_name     = "via-superagent"
    resource_name    = "secret"
    accessor_sa_keys = ["superagent"]
  }
  superagent_session = {
    product_name     = "via-superagent"
    resource_name    = "session"
    accessor_sa_keys = ["superagent"]
  }
  cognito = {
    resource_name    = "cognito"
    accessor_sa_keys = ["supervisor", "superagent"]
  }
}

# Existing Cloud SQL instance in GCP: via-supervisor-devsecops-east4
# (product=via-supervisor, env=devsecops, resource=east4). Do not add extra SQL
# instances here; creating new Cloud SQL during plan can hang for a long time.
sql_instances = {
  east4 = {
    resource_name       = "east4"
    database_version    = "POSTGRES_18"
    tier                = "db-custom-1-3840"
    disk_size_gb        = 10
    databases           = ["ff-freya-supervisor-pac-adk", "ff-freya-supervisor-pac-langgraph"]
    iam_authentication  = true
    pitr_enabled        = true
    query_insights      = true
    deletion_protection = false
    ssl_mode            = "TRUSTED_CLIENT_CERTIFICATE_REQUIRED"
    kms_key_name        = null
  }
}

cloud_run_services = {
  supervisor = {
    resource_name      = "run"
    image              = "us-east4-docker.pkg.dev/freyr-ai/via-supervisor/via-supervisor:dso"
    sa_key             = "supervisor"
    config_bucket_key  = "supervisor"
    session_secret_key = "supervisor_session"
    memory_secret_key  = "supervisor_memory"
    port               = 8080
    cpu                = "2"
    memory             = "4Gi"
    min_instances         = 1
    max_instances         = 3
    concurrency           = 320
    timeout_seconds       = 300
    env_vars = {
      GCS_CONFIG_OBJECT = "ff-freya-supervisor/dev/ff-freya-supervisor-common.json"
    }
    secret_env_keys = {
      VIA_SUPERVISOR_SECRET = "supervisor"
      VIA_SESSION_SECRET    = "supervisor_session"
      VIA_MEMORY_SECRET     = "supervisor_memory"
      VIA_COGNITO_M2M       = "cognito"
    }
    ingress               = "INGRESS_TRAFFIC_ALL"
    allow_unauthenticated = true
    invoker_sa_keys       = []
    extra_invoker_members = []
    deletion_protection   = true
  }
  superagent = {
    product_name       = "via-superagent"
    resource_name      = "run"
    image              = "us-east4-docker.pkg.dev/freyr-ai/via-superagent/via-superagent:dso"
    sa_key             = "superagent"
    config_bucket_key  = "superagent"
    session_secret_key = "superagent_session"
    port               = 8080
    cpu                = "2"
    memory             = "4Gi"
    min_instances         = 1
    max_instances         = 3
    concurrency           = 320
    timeout_seconds       = 300
    env_vars = {
      GCS_CONFIG_OBJECT = "ff-freya-superagents-pac/dev/ff-freya-superagents-pac-common.json"
    }
    secret_env_keys = {
      VIA_SUPERAGENT_SECRET = "superagent"
      VIA_SESSION_SECRET    = "superagent_session"
      VIA_COGNITO_M2M       = "cognito"
    }
    ingress               = "INGRESS_TRAFFIC_ALL"
    allow_unauthenticated = false
    invoker_sa_keys       = ["supervisor"]
    extra_invoker_members = []
    deletion_protection   = true
  }
}

gemini_enterprise = {
  application_id     = "freyr-gemini-enterprise_1776958711324"
  via_agent_id       = "14759281635611028992"
  agent_display_name = "VIA"
}

observability = {
  via_tracing_enabled = true
  traces_endpoint     = "https://telemetry.googleapis.com:443/v1/traces"
  pac_tracing_enabled = false
}

pac_external = {
  regulatory_mcp = "https://api.devsecops.freyafusion.com/grr/requirement-mcp"
  concept_graph  = "https://api.devsecops.freyafusion.com/grr/graph-service"
}
