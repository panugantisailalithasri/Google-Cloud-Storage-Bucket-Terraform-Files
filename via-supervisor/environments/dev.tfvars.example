# via-supervisor / DevSecOps
# Manages supervisor-only resources. Superagent lives in ../via-superagent/.
#
# GCP names composed as productname-ENVname-Resourcename:
#   via-supervisor-devsecops-bucket
#   via-supervisor-devsecops-run
#   via-supervisor-devsecops-sql         (sessions / checkpoints — created)
#   via-supervisor-devsecops-memory-sql  (pgvector / Mem0 — created)

product_name = "via-supervisor"
environment  = "devsecops"
project_id   = "freyr-ai"
region       = "us-east4"
location     = "us-east4"

runtime_service_account_email = "via-supervisor-dso-sa@freyr-ai.iam.gserviceaccount.com"

# Image tag is injected by the pipeline: -var=image_tag=<tag>
# Set a fallback here for local terraform plan without the pipeline.
image_tag = "8fdf73f3aa6b54207991baca73b6ee7837f8e335"

labels = {
  team    = "ai-agents"
  program = "dso"
}

enable_apis = true

vpc_network = "freya-ai-dev-vpc"
vpc_subnet  = "freya-ai-dev-subnet-us-east4"
vpc_egress  = "PRIVATE_RANGES_ONLY"
# Match existing via-supervisor-dso Networking: Direct VPC, private IPs only.
cloud_run_direct_vpc = true
# DSO VPC already has Service Networking. Do not create a second connection.
private_services_connection = {
  enabled       = false
  address       = ""
  prefix_length = 16
}

buckets = {
  supervisor = {
    resource_name      = "bucket"
    storage_class      = "STANDARD"
    versioning_enabled = true
    force_destroy      = false
    lifecycle_age_days = 90
    kms_key_name       = null
    runtime_role       = "roles/storage.objectViewer"
    extra_iam_members  = []
  }
}

secrets = {
  supervisor = {
    resource_name = "secret"
  }
  supervisor_session = {
    resource_name = "session"
  }
  supervisor_memory = {
    resource_name = "memory"
  }
}

# App secret (supervisor) comes from ADO via-supervisor-devsecops-secrets-GCP.
# session + memory JSON is written by Terraform (private IP + app user).
# Never put real secret values in this file.
secret_payloads = {}

# Written to gs://via-supervisor-devsecops-bucket/<object_name>.
# Leave config_object_payloads empty to upload the stack-generated common.json
# (no secret values). Set a handle in ADO to replace the body.
gcs_config_objects = {
  supervisor = {
    bucket_key  = "supervisor"
    object_name = "ff-freya-supervisor/dev/ff-freya-supervisor-common.json"
  }
}
config_object_payloads = {}

# Two Cloud SQL instances, both created with product-env-resource names.
# via-supervisor-devsecops-east4 is not managed here.
sql_instances = {
  sql = {
    resource_name       = "sql"
    edition             = "ENTERPRISE"
    database_version    = "POSTGRES_18"
    tier                = "db-custom-2-4096"
    disk_size_gb        = 10
    databases           = ["ff-freya-supervisor-pac-adk", "ff-freya-supervisor-pac-langgraph"]
    iam_authentication  = true
    pitr_enabled        = true
    query_insights      = true
    deletion_protection = false
    ssl_mode              = "ALLOW_UNENCRYPTED_AND_ENCRYPTED"
    kms_key_name          = null
    app_user              = "via_supervisor"
    connection_secret_key = "supervisor_session"
  }
  memory_sql = {
    resource_name       = "memory-sql"
    edition             = "ENTERPRISE"
    database_version    = "POSTGRES_18"
    tier                = "db-custom-2-8192"
    disk_size_gb        = 53
    databases           = ["mem0_db"]
    iam_authentication  = true
    pitr_enabled        = true
    query_insights      = true
    deletion_protection = false
    ssl_mode              = "ALLOW_UNENCRYPTED_AND_ENCRYPTED"
    kms_key_name          = null
    app_user              = "via_supervisor_memory"
    connection_secret_key = "supervisor_memory"
  }
}

cloud_run_services = {
  supervisor = {
    resource_name      = "run"
    image_repository   = "us-east4-docker.pkg.dev/freyr-ai/via-supervisor/via-supervisor"
    config_bucket_key  = "supervisor"
    session_secret_key = "supervisor_session"
    memory_secret_key  = "supervisor_memory"
    port               = 8000
    cpu                = "2"
    memory             = "4Gi"
    min_instances         = 1
    max_instances         = 3
    concurrency           = 320
    timeout_seconds       = 300
    # Cloud Run env matches live via-supervisor-dso. Remaining settings come
    # from the GCS JSON (VIA_CONFIG_BACKEND=gcp). Do not add HOST/PORT/secrets.
    env_vars        = {}
    secret_env_keys = {}
    ingress               = "INGRESS_TRAFFIC_ALL"
    allow_unauthenticated = true
    extra_invoker_members = []
    deletion_protection   = false
  }
}

gemini_enterprise = {
  application_id     = "freyr-gemini-enterprise_1776958711324"
  via_agent_id       = "14759281635611028992"
  agent_display_name = "VIA"
}

observability = {
  via_tracing_enabled = true
  traces_endpoint     = "https://telemetry.googleapis.com:443/v1/traces"
  pac_tracing_enabled = false
}

pac_external = {
  regulatory_mcp = "https://api.devsecops.freyafusion.com/grr/requirement-mcp"
  concept_graph  = "https://api.devsecops.freyafusion.com/grr/graph-service"
}
