# via-supervisor / dev — Cloud Storage + Secret Manager only (no Cloud Run).
#   terraform plan -var-file=environments/dev.tfvars.example
#
# Bucket count is the map size. This agent uses ONE bucket.
# Another agent using the same modules/gcs-bucket template with TWO buckets:
#   buckets = {
#     bucket = {}
#     data   = {}
#   }
# → <product>-<env>-bucket and <product>-<env>-data

project_id  = "freyr-ai"
region      = "us-east1"
environment = "dev"

buckets = {
  bucket = {
    force_destroy = true
  }
}

secret_keys = [
  "app-config",
]
