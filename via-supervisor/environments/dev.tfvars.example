# via-supervisor / DevSecOps
# Manages supervisor-only resources. Superagent lives in ../via-superagent/.
#
# GCP names composed as productname-ENVname-Resourcename:
#   via-supervisor-devsecops-bucket
#   via-supervisor-devsecops-run
#   via-supervisor-devsecops-east4   (existing Cloud SQL — sessions/checkpoints)

product_name = "via-supervisor"
environment  = "devsecops"
project_id   = "freyr-ai"
region       = "us-east4"
location     = "us-east4"

runtime_service_account_email = "ado-deployer-v3@freyr-ai.iam.gserviceaccount.com"

# Image tag is injected by the pipeline: -var=image_tag=<tag>
# Set a fallback here for local terraform plan without the pipeline.
image_tag = "8fdf73f3aa6b54207991baca73b6ee7837f8e335"

labels = {
  team    = "ai-agents"
  program = "dso"
}

enable_apis = true

vpc_network = "freya-ai-dev-vpc"
vpc_subnet  = "freya-ai-dev-subnet-us-east4"
vpc_egress  = "PRIVATE_RANGES_ONLY"

buckets = {
  supervisor = {
    resource_name      = "bucket"
    storage_class      = "STANDARD"
    versioning_enabled = true
    force_destroy      = false
    lifecycle_age_days = 90
    kms_key_name       = null
    runtime_role       = "roles/storage.objectViewer"
    extra_iam_members  = []
  }
}

secrets = {
  supervisor = {
    resource_name = "secret"
  }
  supervisor_session = {
    resource_name = "session"
  }
  supervisor_memory = {
    resource_name = "memory"
  }
}

# Payloads for supervisor/session/memory come from ADO variable group
# via-supervisor-devsecops-secrets-GCP (pipeline injects TF_VAR_secret_payloads).
# Never put real secret values in this file.
secret_payloads = {}

# Existing Cloud SQL instance.
# Correct convention name: via-supervisor-devsecops-sql
# Actual GCP name:         via-supervisor-devsecops-east4  (Cloud SQL cannot be renamed)
# name_override pins Terraform to the real GCP name. New instances must not use name_override.
sql_instances = {
  sql = {
    resource_name       = "sql"
    name_override       = "via-supervisor-devsecops-east4"
    edition             = "ENTERPRISE_PLUS"
    database_version    = "POSTGRES_18"
    tier                = "db-perf-optimized-N-2"
    disk_size_gb        = 10
    databases           = ["ff-freya-supervisor-pac-adk", "ff-freya-supervisor-pac-langgraph"]
    iam_authentication  = true
    pitr_enabled        = true
    query_insights      = true
    deletion_protection = false
    ssl_mode            = "TRUSTED_CLIENT_CERTIFICATE_REQUIRED"
    kms_key_name        = null
  }
}

cloud_run_services = {
  supervisor = {
    resource_name      = "run"
    image_repository   = "us-east4-docker.pkg.dev/freyr-ai/via-supervisor/via-supervisor"
    config_bucket_key  = "supervisor"
    session_secret_key = "supervisor_session"
    memory_secret_key  = "supervisor_memory"
    port               = 8000
    cpu                = "2"
    memory             = "4Gi"
    min_instances         = 1
    max_instances         = 3
    concurrency           = 320
    timeout_seconds       = 300
    env_vars = {
      HOST        = "0.0.0.0"
      ENVIRONMENT = "dev"
      # Do not set GCS_CONFIG_BUCKET/OBJECT until the JSON exists in that
      # bucket. The composed via-supervisor-devsecops-bucket is empty; a
      # missing object crashes the container before it listens on 8000.
      # config_bucket_name = "existing-shared-config-bucket"
      # GCS_CONFIG_OBJECT  = "ff-freya-supervisor/dev/ff-freya-supervisor-common.json"
    }
    secret_env_keys = {
      VIA_SUPERVISOR_SECRET = "supervisor"
      VIA_SESSION_SECRET    = "supervisor_session"
      VIA_MEMORY_SECRET     = "supervisor_memory"
    }
    ingress               = "INGRESS_TRAFFIC_ALL"
    allow_unauthenticated = true
    extra_invoker_members = []
    deletion_protection   = false
  }
}

gemini_enterprise = {
  application_id     = "freyr-gemini-enterprise_1776958711324"
  via_agent_id       = "14759281635611028992"
  agent_display_name = "VIA"
}

observability = {
  via_tracing_enabled = true
  traces_endpoint     = "https://telemetry.googleapis.com:443/v1/traces"
  pac_tracing_enabled = false
}

pac_external = {
  regulatory_mcp = "https://api.devsecops.freyafusion.com/grr/requirement-mcp"
  concept_graph  = "https://api.devsecops.freyafusion.com/grr/graph-service"
}
