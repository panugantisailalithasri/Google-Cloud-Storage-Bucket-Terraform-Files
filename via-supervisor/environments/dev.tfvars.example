# via-supervisor / dev
#   terraform plan -var-file=environments/dev.tfvars.example

project_id  = "freyr-ai"
region      = "us-east1"
environment = "dev"

buckets = {
  bucket = {
    force_destroy = true
  }
}

secret_keys = [
  "app-config",
]

