# via-supervisor / dev
# Source of truth for every variable in ../variables.tf
#   terraform plan -var-file=environments/dev.tfvars.example
#
# This agent: Cloud Storage + Secret Manager, ONE bucket.
# Another agent with TWO buckets (same modules/gcs-bucket template):
#   buckets = { bucket = { ... }, data = { ... } }

product_name = "via-supervisor"
environment  = "dev"
project_id   = "freyr-ai"
region       = "us-east1"
location     = "us-east1"

# Cloud SQL private IP attaches to the VPC, not directly to a subnetwork.
# Reference VPC details:
#   VPC      = freya-ai-dev-vpc
#   Subnet   = freya-ai-dev-subnet-us-east4
#   Region   = us-east4
vpc_name     = "freya-ai-dev-vpc"
network_project_id = "freyr-ai"

labels = {
  team = "ai-agents"
}

enable_apis = true

# Reuse the existing Azure DevOps deployer service account so Terraform does
# not need iam.serviceAccounts.create on the project.
existing_runtime_service_account_email = "ado-deployer-v3@freyr-ai.iam.gserviceaccount.com"

runtime_sa_resource = "sa"
runtime_sa_roles = [
  "roles/logging.logWriter",
  "roles/monitoring.metricWriter",
]

buckets = {
  bucket = {
    storage_class      = "STANDARD"
    versioning_enabled = true
    force_destroy      = true
    lifecycle_age_days = 90
    kms_key_name       = null
    runtime_role       = "roles/storage.objectUser"
    extra_iam_members  = []
  }
}

# Secrets for three products hosted in this agent stack.
secret_keys = [
  "via-supervisor",
  "via-superagent",
  "cognito",
]

# via-supervisor does not deploy Cloud Run.
cloud_run = null

cloudsql = {
  name                                          = "via-supervisor-devsecops-east4"
  region                                        = "us-east4"
  database_version                              = "POSTGRES_18"
  edition                                       = "ENTERPRISE"
  tier                                          = "db-custom-1-3840"
  availability_type                             = "ZONAL"
  disk_type                                     = "PD_SSD"
  disk_size                                     = 10
  disk_autoresize                               = true
  ipv4_enabled                                  = false
  ssl_mode                                      = "TRUSTED_CLIENT_CERTIFICATE_REQUIRED"
  enable_private_path_for_google_cloud_services = false
  authorized_networks                           = []
  backup_enabled                                = true
  point_in_time_recovery_enabled                = true
  database_flags                                = []
  deletion_protection                           = false
  deletion_protection_enabled                   = false
}
