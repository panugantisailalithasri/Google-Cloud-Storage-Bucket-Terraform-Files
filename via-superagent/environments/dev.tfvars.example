# via-superagent / DevSecOps
# Manages superagent-only resources. Supervisor lives in ../via-supervisor/.
#
# GCP names composed as productname-ENVname-Resourcename:
#   via-superagent-devsecops-bucket
#   via-superagent-devsecops-run
#   via-superagent-devsecops-sql
#   via-superagent-devsecops-secret / session / cognito

product_name = "via-superagent"
environment  = "devsecops"
project_id   = "freyr-ai"
region       = "us-east4"
location     = "us-east4"

runtime_service_account_email = "via-superagent-dso-sa@freyr-ai.iam.gserviceaccount.com"

# Image tag is injected by the pipeline: -var=image_tag=<tag>
image_tag = "8fdf73f3aa6b54207991baca73b6ee7837f8e335"

labels = {
  team    = "ai-agents"
  program = "dso"
}

enable_apis = true

vpc_network = "freya-ai-dev-vpc"
vpc_subnet  = "freya-ai-dev-subnet-us-east4"
vpc_egress  = "PRIVATE_RANGES_ONLY"
cloud_run_direct_vpc = true

buckets = {
  superagent = {
    resource_name      = "bucket"
    storage_class      = "STANDARD"
    versioning_enabled = true
    force_destroy      = false
    lifecycle_age_days = 90
    kms_key_name       = null
    runtime_role       = "roles/storage.objectViewer"
    extra_iam_members  = []
  }
}

secrets = {
  superagent = {
    resource_name = "secret"
  }
  superagent_session = {
    resource_name = "session"
  }
  cognito = {
    resource_name = "cognito"
  }
}

# App + cognito payloads come from ADO via-superagent-devsecops-secrets-GCP.
# session JSON is written by Terraform (private IP + via_superagent).
secret_payloads = {}

gcs_config_objects = {
  superagent = {
    bucket_key  = "superagent"
    object_name = "ff-freya-superagents-pac/dev/ff-freya-superagents-pac-common.json"
  }
}
config_object_payloads = {}

# Existing Cloud SQL instance for superagent sessions.
sql_instances = {
  sql = {
    resource_name       = "sql"
    edition             = "ENTERPRISE"
    database_version    = "POSTGRES_18"
    tier                = "db-custom-2-4096"
    disk_size_gb        = 10
    databases           = ["ff-freya-sa-pac-langgraph"]
    iam_authentication  = true
    pitr_enabled        = true
    query_insights      = true
    deletion_protection = false
    ssl_mode              = "ALLOW_UNENCRYPTED_AND_ENCRYPTED"
    kms_key_name          = null
    app_user              = "via_superagent"
    connection_secret_key = "superagent_session"
  }
}

cloud_run_services = {
  superagent = {
    resource_name      = "run"
    image_repository   = "us-east4-docker.pkg.dev/freyr-ai/via-superagent/via-superagent"
    config_bucket_key  = "superagent"
    session_secret_key = "superagent_session"
    port               = 8000
    cpu                = "2"
    memory             = "4Gi"
    min_instances         = 1
    max_instances         = 3
    concurrency           = 320
    timeout_seconds       = 300
    # Cloud Run env matches live via-superagent-dso. Remaining settings come
    # from the GCS JSON (PAC_CONFIG_BACKEND=gcp). Do not add HOST/PORT/secrets.
    env_vars              = {}
    secret_env_keys       = {}
    extra_secret_env_vars = {}
    ingress               = "INGRESS_TRAFFIC_ALL"
    allow_unauthenticated = false
    extra_invoker_members = ["serviceAccount:via-supervisor-dso-sa@freyr-ai.iam.gserviceaccount.com"]
    deletion_protection   = false
  }
}

gemini_enterprise = {
  application_id     = "freyr-gemini-enterprise_1776958711324"
  via_agent_id       = "14759281635611028992"
  agent_display_name = "VIA"
}

observability = {
  via_tracing_enabled = true
  traces_endpoint     = "https://telemetry.googleapis.com:443/v1/traces"
  pac_tracing_enabled = false
}

pac_external = {
  regulatory_mcp = "https://api.devsecops.freyafusion.com/grr/requirement-mcp"
  concept_graph  = "https://api.devsecops.freyafusion.com/grr/graph-service"
}
