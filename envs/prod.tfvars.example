# Example values for the prod environment.
# product_name is passed by Azure DevOps (or locally):
#   terraform plan -var="product_name=via-supervisor" -var-file=../envs/prod.tfvars.example

project_id  = "freyr-ai"
region      = "us-east1"
environment = "prod"

buckets = {
  bucket = {
    force_destroy = false
  }
}

secret_keys = [
  "app-config",
]

